---
// @ts-nocheck
import FinancialCard from "./FinancialCard.astro";
import ArrowLeft from "../icons/arrow-left.svg";
import ArrowRight from "../icons/arrow--right.svg";

// Henter indholdet til sektionen fra API'et
let financialData;

try {
  const response = await fetch(
    "https://ftk-api.pages.dev/financial-projections",
  );

  // Tjekker om API-kaldet lykkedes
  if (!response.ok) {
    throw new Error("Kunne ikke hente data");
  }

  financialData = await response.json();
} catch (error) {
  console.error(error);

  // Fallback, hvis API'et ikke svarer
  financialData = {
    eyebrow: "",
    title: "Financial Projections",
    subtitle: "Content is currently unavailable.",
    values: [],
  };
}
---

<section class="financial-projections">
  <!-- Holder indholdet centreret, mens baggrunden fylder hele bredden -->
  <div class="financial-content">
    <!-- Placerer tekst og navigationspile ved siden af hinanden -->
    <div class="financial-header">
      <div class="financial-text flow">
        <span class="eyebrow">{financialData.eyebrow}</span>
        <h2>{financialData.title}</h2>
        <p>{financialData.subtitle}</p>
      </div>

      <div class="financial-navigation">
        <button type="button" class="prev" aria-label="Forrige kort">
          <ArrowLeft />
        </button>

        <button type="button" class="next" aria-label="Næste kort">
          <ArrowRight />
        </button>
      </div>
    </div>

    <!-- Viser alle kort fra API'et i en vandret slider -->
    <div class="financial-slider">
      <div class="financial-cards">
        {financialData.values.map((item) => <FinancialCard item={item} />)}
      </div>
    </div>
  </div>
</section>

<script>
  // @ts-nocheck

  // Finder kortene, knapperne og sliderens container
  const cards = document.querySelectorAll(".financial-cards > *");
  const nextButton = document.querySelector(".next");
  const prevButton = document.querySelector(".prev");
  const cardsContainer = document.querySelector(".financial-cards");

  // Holder styr på det første synlige kort
  let currentIndex = 0;

  // Bestemmer antallet af synlige kort ud fra skærmbredden
  function getVisibleCards() {
    if (window.innerWidth <= 700) return 1;
    if (window.innerWidth <= 1000) return 2;
    return 4;
  }

  // Flytter kortene vandret, når brugeren klikker på pilene
  function showCards() {
    if (!cardsContainer || !cards[0]) return;

    const gap = parseFloat(getComputedStyle(cardsContainer).columnGap);
    const cardWidth = cards[0].getBoundingClientRect().width;

    cardsContainer.style.transform = `translateX(-${currentIndex * (cardWidth + gap)}px)`;
  }

  // Bladrer frem ud fra antallet af synlige kort
  nextButton?.addEventListener("click", () => {
    if (currentIndex < cards.length - getVisibleCards()) {
      currentIndex++;
      showCards();
    }
  });

  // Bladrer tilbage til forrige kort
  prevButton?.addEventListener("click", () => {
    if (currentIndex > 0) {
      currentIndex--;
      showCards();
    }
  });

  // Viser de første kort, når siden indlæses
  showCards();
</script>

<style>
  /* Sektionens baggrund fylder hele skærmens bredde */
  .financial-projections {
    background-color: var(--color-surface-secondary);
    padding: var(--space-8);
    box-sizing: border-box;
    width: 100vw;
    position: relative;
    left: 50%;
    margin-left: -50vw;
  }

  /* Centrerer indholdet inden for sektionen */
  .financial-content {
    max-width: 1200px;
    margin-inline: auto;
  }

  /* Farve og afstand på overskriften */
  .financial-projections h2 {
    color: var(--color-text);
    margin: 0;
  }

  /* Farve og bredde på beskrivelsen */
  .financial-projections p {
    color: var(--color-text-muted);
    max-width: 645px;
  }

  /* Placerer kortene på én række med glidende animation */
  .financial-cards {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 3 * var(--space-5)) / 4);
    gap: var(--space-5);
    margin-top: var(--space-8);
    transition: transform 0.4s ease;
  }

  /* Navigationsknapperne */
  .financial-navigation {
    display: flex;
    gap: var(--space-2);
  }

  .financial-navigation button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border: none;
    border-radius: 50%;
    background-color: var(--color-neutrals-900);
    color: white;
    cursor: pointer;
  }

  .financial-navigation button svg {
    width: 20px;
    height: 20px;
  }

  /* Placerer tekst og navigationspile ved siden af hinanden */
  .financial-header {
    display: flex;
    align-items: flex-end;
    gap: var(--space-9);
  }

  /* Bestemmer bredden og afstanden i tekstområdet */
  .financial-text {
    flex: 0 1 645px;
    --flow-space: var(--space-2);
  }

  /* Skjuler kortene uden for sliderens synlige område */
  .financial-slider {
    overflow: hidden;
  }

  /* Tablet – viser to kort ad gangen */
  @media (max-width: 1000px) {
    .financial-cards {
      grid-auto-columns: calc((100% - var(--space-5)) / 2);
    }
  }

  /* Mobil – viser ét kort ad gangen */
  @media (max-width: 700px) {
    .financial-cards {
      grid-auto-columns: 100%;
    }
  }
</style>
