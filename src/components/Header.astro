---
const currentPath = Astro.url.pathname;
---

<header>
  <nav aria-label="Hovednavigation">
    <!-- Logo -->
    <a href="/" class="logo">
      Ask<span>Experts</span>
    </a>
    <!-- Navigationslinks -->
    <div class="nav-links">
      <a href="/" class:list={{ active: currentPath === "/" }}> Home </a>

      <a
        href="/case-studies/taxes-and-efficiency"
        class:list={{ active: currentPath.startsWith("/case-studies") }}
      >
        Case Studies
      </a>

      <a href="/team" class:list={{ active: currentPath.startsWith("/team") }}>
        Team
      </a>

      <a href="/about" class:list={{ active: currentPath === "/about" }}>
        About
      </a>
    </div>
    <!-- Login-knap -->
    <button type="button" class="login-button" popovertarget="login-popover">
      Login
    </button>
  </nav>
</header>

<!-- Styling -->
<style>
  header {
    background-color: var(--color-ui-primary);
    padding: 38px;
  }

  nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    max-width: 1200px;
    margin-inline: auto;
  }

  .logo {
    justify-self: start;
    color: var(--color-on-ui-primary);
    text-decoration: none;
    font-weight: 700;
  }

  .logo span {
    color: var(--color-action);
  }

  .nav-links {
    display: flex;
    justify-self: center;
    align-items: center;
    gap: var(--space-nav-gap);
  }

  .nav-links a {
    color: var(--color-on-ui-primary);
    font-family: var(--font-lato);
    font-size: var(--font-size-nav);
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-nav);
    text-decoration: none;
  }

  .login-button {
    justify-self: end;
    background-color: var(--color-on-ui-primary);
    color: var(--color-ui-primary);
    padding: 4px 16px;
    border: none;
    border-radius: var(--radius-pill);
    cursor: pointer;
  }

  .nav-links a.active {
    text-decoration: underline;
    text-decoration-color: var(--color-action);
    text-underline-offset: 5px;
  }
</style>
