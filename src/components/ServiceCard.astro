---
const { service } = Astro.props;
import Button from "./Button.astro";
---

<article>
  <h2>{service.title}</h2>
  <p>{service.description}</p>
  <Button href="#0" variant="text" showArrow={true}>
    {service.buttonText}
  </Button>
</article>

<style>
  @layer components {
    article {
      background: var(--color-blue-700-transparent);
      color: var(--color-on-surface-elevated);
      padding: 2rem; /* Dette burde være en token */
      border-radius: 20px; /* Dette burde være en token */
    }
  }
</style>
