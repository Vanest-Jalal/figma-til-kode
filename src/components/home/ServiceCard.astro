---
const { service } = Astro.props;
import Button from "@components/shared/Button.astro";
---

<article class="flow">
  <h2>{service.title}</h2>
  <p>{service.description}</p>
  <Button variant="text" showArrow={true}>
    {service.buttonText}
  </Button>
</article>

<style>
  @layer components {
    article {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      /* Styrer afstanden mellem kortets elementer */
      --flow-space: var(--space-2);
      padding: var(--space-6);
      border-radius: var(--radius-lg);
      background: var(--color-surface-elevated-transparent);
      color: var(--color-on-surface-elevated);
      backdrop-filter: blur(16px);
    }

    /* Mindre overskrift til servicekortene */
    article h2 {
      font-size: 1.5rem; /* 24px */
      margin: 0;
    }

    /* Placerer linket nederst i kortet */
    article :global(.button) {
      margin-top: auto;
    }
  }
  /* Mobilversion af servicekort */
  @media (max-width: 700px) {
    article {
      /* Mindre indvendig afstand på mobil */
      padding: var(--space-4);
    }
  }
</style>
