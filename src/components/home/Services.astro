---
// @ts-nocheck
import ServiceCard from "./ServiceCard.astro";

// Henter services fra API'et
let serviceData;

try {
  const response = await fetch("https://ftk-api.pages.dev/services");

  // Tjekker om API-kaldet lykkedes
  if (!response.ok) {
    throw new Error("Kunne ikke hente services");
  }

  serviceData = await response.json();
} catch (error) {
  console.error(error);

  // Fallback, hvis API'et ikke svarer
  serviceData = [];
}
---

<div class="services">
  {serviceData.map((service) => <ServiceCard service={service} />)}
</div>

<!-- Styling -->
<style>
  @layer components {
    /* Layout til de tre servicekort */
    .services {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.25rem; /* 20px */
      max-width: 75rem;
      width: 100%;
      margin-inline: auto;
    }

    /* Mobil */
    @media (max-width: 700px) {
      .services {
        grid-template-columns: minmax(0, 1fr);
      }
    }
  }
</style>
