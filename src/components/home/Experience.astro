---
import experienceData from "../../data/experience.json";
import StatList from "./StatList.astro";
---

<!-- Experience-sektionen med tekst og statistik -->
<section class="experience">
  <div class="experience-content">
    <!-- Sektionens overskrift og beskrivelse -->
    <div class="experience-text flow">
      <span class="eyebrow">Experience</span>
      <h2>More than 25 years of experience</h2>
      <p>3000+ our clients are insured around the World</p>
    </div>

    <!-- Viser de tre procentcirkler fra experience.json -->
    <div class="experience-stats">
      <StatList stats={experienceData.stats} />
    </div>
  </div>
</section>

<!-- Styling -->
<style>
  @layer components {
    /* Sektionens gule baggrund */
    .experience {
      display: flex;
      align-items: center;
      background-color: var(--color-surface-highlight);
      padding: var(--space-6-5);
      width: 100vw;
      min-height: 528px;
      position: relative;
      left: 50%;
      margin-left: -50vw;
      box-sizing: border-box;
    }

    /* Placerer tekst og procentcirkler ved siden af hinanden */
    .experience-content {
      width: 100%;
      max-width: 75rem;
      margin-inline: auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-6);
    }

    .experience-text {
      --flow-space: var(--space-4);
    }

    .experience-text p {
      font-size: 1rem; /* 16px */
    }

    /* Tilpasser Experience til tablet og mobil */
    @media (max-width: 1000px) {
      .experience-content {
        /* Placerer teksten over procentcirklerne */
        flex-direction: column;
      }
    }
  }
</style>
