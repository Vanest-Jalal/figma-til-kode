---
import { Image } from "astro:assets";
import Services from "./Services.astro";
import Button from "@components/shared/Button.astro";
import CEOImage from "@assets/images/ceo.webp";
---

<section class="hero">
  <div class="hero-content">
    <div class="hero-text flow">
      <h1>Empowering Your Business Growth</h1>
      <p>
        Discover tailored strategies and expert insights to take your business
        to the next level. Let us help you navigate challenges and achieve
        sustainable success.
      </p>
    </div>

    <!-- Knapper i Hero -->
    <div class="hero-buttons">
      <Button variant="primary">Book a Meeting</Button>

      <Button variant="secondary" showArrow={true}> Learn More </Button>
    </div>
  </div>
  <Image src={CEOImage} alt="CEO" class="hero-image" />
  <Services />
</section>

<!-- Styling -->
<style>
  @layer components {
    .hero {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      background-color: var(--color-ui-primary);
      /* Giver plads til service-kortenes overlap og afstand til næste sektion */
      margin-bottom: calc(132px + var(--space-8));
    }

    .hero > :global(.services) {
      grid-column: 1 / -1;
      position: relative;
      z-index: 1;
      margin-top: -132px;
      transform: translateY(132px);
    }

    /* Styrer afstanden mellem overskrift og brødtekst */
    .hero-text {
      --flow-space: var(--space-4);
    }

    .hero-content {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: flex-start;
      gap: var(--space-hero-content-gap);
      padding: var(--space-8);
      padding-left: max(var(--space-8), calc((100vw - 75rem) / 2));
      color: var(--color-on-ui-primary);
      position: relative;
      overflow: hidden;
    }

    /* Hovedoverskrift i Hero */
    .hero-content h1 {
      color: var(--color-on-ui-primary);
      margin: 0;
    }

    /* Beskrivende tekst i Hero */
    .hero-content p {
      color: var(--color-on-ui-primary-muted);
      margin: 0;
    }

    .hero-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .hero-buttons {
      display: flex;
      align-items: center;
      gap: var(--space-4);
    }

    /* Dekorativt grid-mønster bag hero-teksten */
    .hero-content::before {
      content: "";
      position: absolute;
      top: 70px;
      left: 10%;
      width: 998px;
      height: 611px;

      background-image:
        linear-gradient(to right, var(--color-action) 1px, transparent 1px),
        linear-gradient(to bottom, var(--color-action) 1px, transparent 1px);

      background-size: 60px 60px;
      opacity: 0.18;

      mask-image: radial-gradient(ellipse, black, transparent 70%);
      pointer-events: none;
    }

    /* Holder teksten og knapperne foran mønsteret */
    .hero-text,
    .hero-buttons {
      position: relative;
      z-index: 1;
    }

    /* Gul dekorativ linje bag overskriften */
    .hero-content::after {
      content: "";
      position: absolute;
      top: 30%;
      left: 0;
      width: 360px;
      height: 7px;
      background: linear-gradient(to right, transparent, var(--color-action));
      pointer-events: none;
    }
  }

  /* Mobilversion af Hero */
  @media (max-width: 700px) {
    .hero {
      /* Ændrer Hero fra to kolonner til én kolonne */
      grid-template-columns: 1fr;
    }
  }
</style>
