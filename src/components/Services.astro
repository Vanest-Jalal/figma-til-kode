---
//@ts-nocheck
import ServiceCard from "@components/ServiceCard.astro";

const serviceData = await fetch("https://ftk-api.pages.dev/services").then(
  (res) => res.json(),
);
---

<div class="services">
  {serviceData.map((service) => <ServiceCard service={service} />)}
</div>

<style>
  @layer components {
    .services {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.25rem; /* 20px */
      max-width: 1200px;
      width: 100%;
      margin-inline: auto;
    }
  }
</style>
