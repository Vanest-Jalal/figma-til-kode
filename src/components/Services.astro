---
// @ts-nocheck
import ServiceCard from "@components/ServiceCard.astro";

// Henter services fra API'et
let serviceData;

try {
  const response = await fetch("https://ftk-api.pages.dev/services");

  // Tjekker om API-kaldet lykkedes
  if (!response.ok) {
    throw new Error("Kunne ikke hente services");
  }

  serviceData = await response.json();
} catch (error) {
  console.error(error);

  // Fallback, hvis API'et ikke svarer
  serviceData = [];
}
---

<div class="services">
  {serviceData.map((service) => <ServiceCard service={service} />)}
</div>

<style>
  @layer components {
    .services {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.25rem; /* 20px */
      max-width: 1200px;
      width: 100%;
      margin-inline: auto;
    }
  }

  /* Mobilversion af Services */
  @media (max-width: 700px) {
    .services {
      /* Placerer servicekortene under hinanden */
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
