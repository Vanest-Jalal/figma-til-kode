---
import { Image } from "astro:assets";
import visionImage from "../../assets/images/about-vision.jpg";
import Checkmark from "../../icons/checkmark.svg";

---

<section class="about-vision">
  <div class="vision-inner">
    <div class="vision-content">
      <p class="eyebrow">OUR VISION</p>
      <h2>Turn your ideas into reality.</h2>

      <p>
        Capitalize on low hanging fruit to identify a ballpark value added
        activity beta test. Override the digital divide with additional from
        DevOps.
      </p>

      <ul class="vision-list">
        <li>
          <Checkmark aria-hidden="true" />
          <span>
            Bring to the table win-win survival strategies to ensure proactive
            domination. At the end of the day.
          </span>
        </li>
        <li>
          <Checkmark aria-hidden="true" />
          <span>
            Capitalize on low hanging fruit to identify a ballpark value added
            activity to beta test override the digital.
          </span>
        </li>
      </ul>
    </div>

    <div class="vision-image">
      <Image
        src={visionImage}
        alt="Tre kolleger arbejder sammen omkring et bord"
      />
    </div>
  </div>
</section>

<style>
.vision-content h2 {
  font-family: var(--font-cabin);
  font-size: 45px;
  font-weight: 700;
  line-height: 1.16;
}

.vision-content > p:not(.eyebrow) {
  font-family: var(--font-lato);
  font-size: 16px;
  font-weight: 400;
  line-height: 1.475;
  color: var(--color-text-muted);
}

.about-vision {
  grid-column: full;
  display: grid;
  grid-template-columns: subgrid;
  padding-block: var(--space-8);
}

 .vision-image img {
  display: block;
  position: relative;
  z-index: 1;
  width: 100%;
  height: auto;
  border-radius: var(--radius-md);
}

.vision-list {
  list-style: none;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.vision-list li {
  display: flex;
  align-items: flex-start;
  gap: 20px;
}

.vision-list li svg {
  width: 20px;
  height: 20px;
  flex-shrink: 0;
  color: var(--color-green-500);
  margin-top: 5px;
}

.vision-image {
  position: relative;
   width: 100%;
  max-width: 500px;
  margin-left: auto;
}

.vision-image::before {
  content: "";
  position: absolute;
  top: -20px;
  right: -20px;
  width: 113px;
  height: 126px;
  background-color: var(--color-ui-secondary);
  border-radius: 20px;
}

.vision-inner {
  grid-column: content;
  display: grid;
  grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
  gap: var(--space-6);
  align-items: center;

  width: 100%;
  max-width: 1000px;
  justify-self: center;
}



@media (max-width: 750px) {
  .vision-inner {
    grid-template-columns: minmax(0, 1fr);
    
  }

  .vision-image {
    margin-inline: auto;
    max-width: 90%;
    
  }

  .vision-content h2 {
    font-size: clamp(28px, 6vw, 45px);
  }
}
</style>