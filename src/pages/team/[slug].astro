---
//@ts-nocheck
import { getTeamMembers } from "@lib/api";
import Layout from "@layouts/Layout.astro";
import TeamMemberDetail from "@components/team/TeamMemberDetail.astro";

// Opretter en dynamisk side for hver medarbejder
export async function getStaticPaths() {
  const team = await getTeamMembers();

  return team.map((employee) => ({
    params: { slug: employee.slug },
    props: { employee },
  }));
}

const { employee } = Astro.props;
---

<Layout>
  <TeamMemberDetail employee={employee} />
</Layout>
