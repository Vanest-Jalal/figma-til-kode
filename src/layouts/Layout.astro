---
import "@styles/main.css";
import { Font } from "astro:assets";
import Header from "../components/Header.astro";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>DIN TITEL HER. MÅSKE SOM PROP?</title>
    <Font cssVariable="--font-cabin" preload />
    <Font cssVariable="--font-lato" preload />
    <style is:inline>
      @layer reset, global, tokens, components, overrides;
    </style>
  </head>
  <body>
    <Header />

    <main class="page-layout">
      <slot />
    </main>
  </body>
</html>

<style>
  .page-layout {
    display: grid;
    grid-template-columns:
      [full-start] minmax(1rem, 1fr)
      [content-start] minmax(0, 1200px)
      [content-end] minmax(1rem, 1fr)
      [full-end];

    width: 100%;
    min-width: 0;
  }

  .page-layout > :global(*) {
    grid-column: content;
    min-width: 0;
  }

  .page-layout > :global(.hero),
  .page-layout > :global(.newsletter),
  .page-layout > :global(.footer) {
    grid-column: full;
  }

  @media (max-width: 600px) {
    .page-layout {
      grid-template-columns:
        [full-start] 1rem
        [content-start] minmax(0, 1fr)
        [content-end] 1rem
        [full-end];
    }
  }
</style>
