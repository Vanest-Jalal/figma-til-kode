---
import "@styles/main.css";
import { Font } from "astro:assets";
import Header from "@components/shared/Header.astro";
import Footer from "@components/shared/Footer.astro";
import Newsletter from "@components/shared/Newsletter.astro";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>DIN TITEL HER. MÅSKE SOM PROP?</title>
    <Font cssVariable="--font-cabin" preload />
    <Font cssVariable="--font-lato" preload />
    <style is:inline>
      @layer reset, global, tokens, components, overrides;
    </style>
  </head>
  <body>
    <Header />

    <main class="page-layout">
      <slot />
    </main>
    <Newsletter />
    <Footer />
  </body>
</html>

<style>
  .page-layout {
    display: grid;
    grid-template-columns:
      [full-start] minmax(1rem, 1fr)
      [content-start] minmax(0, 1200px)
      [content-end] minmax(1rem, 1fr)
      [full-end];
  }

  .page-layout > :global(*) {
    grid-column: content;
  }

  .page-layout > :global(.hero),
  .page-layout > :global(.newsletter),
  .page-layout > :global(.about-intro) {
    grid-column: full;
  }
</style>
